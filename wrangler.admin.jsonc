// 管理画面の Worker(API `/api/admin/*` + Next の静的書き出し = PR3c で画面が入った)。
// 配信の Worker(wrangler.delivery.jsonc)とは別。**配信の不具合と管理画面の不具合を切り離す**(D-296)。
//
// 🔴 **秘密はここに書かない**(ADMIN_PASSWORD_HASH / ADMIN_EMAIL / ADMIN_OWNER_ID / ADMIN_RATE_LIMIT_KEY)。
//   `npm run admin:hash` の出力を `wrangler secret put` で置く。ローカルは `.dev.vars`(.gitignore 済み)。
//   ⚠ この設定ファイルに鍵の名前が現れたら検査が落ちる(tests/admin-config.test.ts)。
// ⚠ `database_id` は仮の値(Cloudflare 側にまだ作っていない)。本番は `wrangler d1 create adpop` の id に差し替える。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adpop-admin",
  "main": "src/admin/worker.ts",
  "compatibility_date": "2026-09-30",
  // 🔴 `wrangler deploy` は `out/` をそのまま配り、`_headers` の有無を見ない(本番前の点検 P1)。
  //   `next build` だけで止めた `out/` を deploy すると CSP 無しで本番に出る(fail-open)。
  //   deploy の前に必ず「埋め込み → next build → _headers 組み立て → CSP・決定済みの配信元・
  //   D1 の id の一致を見る検査」の全工程を通す。
  //   `NEXT_PUBLIC_DELIVERY_ORIGIN` はこのコマンドを呼ぶシェルの環境変数で渡す(docs/deploy.md)。
  "build": {
    "command": "npm run build && node scripts/check-admin-headers.mjs && node scripts/check-database-ids-match.mjs"
  },
  // 🔴 既定値に頼らず明示する(security 監査 M7)。
  //   Version URL(preview_urls)は、修正前の版を本番の secret と D1 のまま動かし続けるので切る。
  "workers_dev": true,
  "preview_urls": false,
  // 🔴 `/api/*` だけ Worker を先に走らせる(Hono)。それ以外は Next の静的書き出し(`out/`)を静的配信する
  //   (ADPOP-PR3b-設計 改訂v2 §0)。静的ファイルがある URL は Worker を起こさず配る(課金されない)。
  "assets": { "directory": "./out", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adpop",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "adpop-images" }],
  // 🔴 呼び出しのログ(Request / Response とメタデータ)を Cloudflare に残さない(security 監査 L11)。
  //   残すのは匿名化したエラーの1行だけ(src/lib/log/redact.ts)。
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
