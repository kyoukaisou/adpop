# ADPOP の環境変数(キー名だけ。値は絶対にコミットしない)
#
# 値の取り方: `supabase start` の出力に URL と anon key が出る。
# ⚠ ここへ実値を書かない。実値は `.env.local`(.gitignore 済み)へ置く。

# --- Supabase(ローカルのみ。クラウドのプロジェクトはまだ作らない)---
NEXT_PUBLIC_SUPABASE_URL=

# 🔴 配信エンドポイントが使う鍵。**サーバーだけが読む**(NEXT_PUBLIC_ を付けない)。
#   ⚠ PR2 の途中まで anon の鍵を使っていたが、**anon に EXECUTE を配ると
#     PostgREST の /rest/v1/rpc/... を誰でも直接叩けて、
#     ルートに置いた守り(本文 4KB の上限・将来のレート制限)を迂回できた**ので変えた(0004)。
#   🔴 この鍵で届くのは **0004 の allow-list に宣言した関数2本だけ**:
#     ・6つの業務テーブルには権限が1つも無い(関門 (a)(a2)(b) が毎回測る)
#     ・EXECUTE を持ってよい関数は宣言した分だけ(関門 (c))
#     ・2本とも自分で認可をする(サイトキー × Origin × 許可ドメイン)
#     = **RLS を迂回して表に届く経路は無い。** 認可は引き続き DB に在る。
#   ⚠ それでも**サーバーの外に出さない**。値は .env.local と、本番のホスティングの秘密欄にだけ置く。
SUPABASE_SERVICE_ROLE_KEY=

# ⚠ anon の鍵は使っていない(anon から呼べる関数は0本)。欄も作らない。

# --- 配信ホスト(PR2 で使う)---
# 埋め込みタグの src に入るホスト。ドメインは未取得なので Vercel の既定ドメインになる。
# ⚠ コードに直書きしない(要件書 §9 の実装制約)。
ADPOP_DELIVERY_ORIGIN=

# --- Cloudflare R2(PR3 で使う。PR1 では触らない)---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
