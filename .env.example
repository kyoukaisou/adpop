# ADPOP の環境変数(キー名だけ。値は絶対にコミットしない)
#
# 値の取り方: `supabase start` の出力に URL と anon key が出る。
# ⚠ ここへ実値を書かない。実値は `.env.local`(.gitignore 済み)へ置く。

# --- Supabase(ローカルのみ。クラウドのプロジェクトはまだ作らない)---
# 管理画面(PR3)が使う。⚠ 配信エンドポイントはこれを使わない。
NEXT_PUBLIC_SUPABASE_URL=

# 🔴 配信エンドポイントが使う接続文字列。**サーバーだけが読む**(NEXT_PUBLIC_ を付けない)。
#   ユーザーは専用ロール `adpop_delivery`(0005 が作る)。パスワードは運用側で設定する。
#   例(本番): postgresql://adpop_delivery:<パスワード>@<pooler のホスト>:6543/postgres
#   例(ローカル): postgresql://adpop_delivery:<パスワード>@127.0.0.1:54522/postgres?sslmode=disable
#
#   🔴 **TLS は必須**。降ろせるのは **ホストがループバックで、かつ URL に sslmode=disable と
#     明示したとき**だけ(ローカルの Supabase は ssl = off のため)。
#     ⚠ **本番のホストでは sslmode=disable と書いても降りない。**
#
#   🔴 **この接続文字列が漏れたら何ができるか**:
#     **関門が数える権限の種別の範囲では、配信の関数2本を呼べるだけ。**
#     ⚠ **「それ以外は何もできない」とは書かない** —— 数えていない種別があるため。
#     ・数える種別: 表(列単位含む)/ 連番 / 関数の EXECUTE / スキーマの USAGE・CREATE /
#       データベースの CONNECT・TEMPORARY・CREATE / ロールのメンバー関係 / ロールの属性 /
#       ロールの既定 GUC
#     ・**数えない種別**: 型・ドメイン / 言語 / テーブル空間 / FDW・外部サーバー /
#       ラージオブジェクト / パラメータ(ALTER SYSTEM) / **PUBLIC が既に持っている分**
#     ・**DB の外**: TLS 設定 / pooler の設定 / pg_hba / ネットワーク到達性 は測っていない
#     ⚠ 数えた範囲でも防げないこと: サイトキーと許可 Origin を知っていれば
#       **イベントを好きなだけ入れられる**(レート制限は PR4)。
#
#   ⚠ **経緯**: PR2 の途中で「この資格で届くのは2関数ちょうど」と2度書き、2度とも覆った。
#     1回目は Supabase の service_role の鍵を使い、測っていたのは /rest/v1 の public だけで
#     **Auth Admin API と Storage に通っていた**(利用者を消すと cascade で配下データが全部消える)。
#     2回目は「全スキーマで数え上げた」と書いたが、**数え上げを1つ足すたびに数えていないものが出た**。
#     → いまは **数える種別を名指しし、数えない種別も名指しする**形にしてある。
ADPOP_DATABASE_URL=

# ⚠ Supabase の API キー(anon / service_role)は配信では使わない。欄も作らない。

# --- 配信ホスト(PR2 で使う)---
# 埋め込みタグの src に入るホスト。ドメインは未取得なので Vercel の既定ドメインになる。
# ⚠ コードに直書きしない(要件書 §9 の実装制約)。
ADPOP_DELIVERY_ORIGIN=

# --- Cloudflare R2(PR3 で使う。PR1 では触らない)---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
