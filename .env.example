# ADPOP の環境変数(キー名だけ。値は絶対にコミットしない)
#
# 値の取り方: `supabase start` の出力に URL と anon key が出る。
# ⚠ ここへ実値を書かない。実値は `.env.local`(.gitignore 済み)へ置く。

# --- Supabase(PR1 ではローカルのみ。クラウドのプロジェクトは作らない)---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ service_role の鍵はこのプロダクトでは使わない。
#   認可は DB(RLS + GRANT)に委ねる。バイパス用の鍵を置く欄を作らない。

# --- 配信ホスト(PR2 で使う)---
# 埋め込みタグの src に入るホスト。ドメインは未取得なので Vercel の既定ドメインになる。
# ⚠ コードに直書きしない(要件書 §9 の実装制約)。
ADPOP_DELIVERY_ORIGIN=

# --- Cloudflare R2(PR3 で使う。PR1 では触らない)---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
